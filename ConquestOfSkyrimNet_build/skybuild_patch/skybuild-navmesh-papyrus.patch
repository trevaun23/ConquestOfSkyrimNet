diff --git a/src/navmesh/runtime/NavmeshPapyrus.cpp b/src/navmesh/runtime/NavmeshPapyrus.cpp
new file mode 100644
index 0000000..d06db15
--- /dev/null
+++ b/src/navmesh/runtime/NavmeshPapyrus.cpp
@@ -0,0 +1,80 @@
+// Papyrus access to SkyBuild's runtime navmesh generation, so other mods (Conquest of SkyrimNet's settlements)
+// can ask for the navmesh around the player to be rebuilt and follow its progress.
+#include "navmesh/runtime/RuntimeNavmesh.h"
+#include "building/BuildingManager.h"
+
+namespace SkyBuild::Navmesh {
+namespace {
+// Same as the "Navmesh" sector of SkyBuild's tool wheel: generate around the player.
+bool RequestNavmesh(RE::StaticFunctionTag *) {
+  const auto tasks = SKSE::GetTaskInterface();
+  if (!tasks)
+    return false;
+  tasks->AddTask([] { RequestGeneration(); });
+  return true;
+}
+// 0 awaiting engine, 1 idle, 2 capturing, 3 building, 4 generated, 5 failed
+std::int32_t NavmeshStage(RE::StaticFunctionTag *) {
+  return static_cast<std::int32_t>(GetStatus().stage);
+}
+bool NavmeshBusy(RE::StaticFunctionTag *) {
+  const auto s = GetStatus();
+  return s.generating || s.stage == RuntimeStage::kCapturing ||
+         s.stage == RuntimeStage::kBuilding;
+}
+float NavmeshProgress(RE::StaticFunctionTag *) { return GetStatus().progress; }
+RE::BSFixedString NavmeshMessage(RE::StaticFunctionTag *) {
+  return RE::BSFixedString(GetStatus().message.c_str());
+}
+// Another mod's building joins SkyBuild's placed objects, so navmesh generation cuts around it like SkyBuild's own
+// pieces (as its own building, at its own position and angle). Done on the game thread.
+bool TrackObject(RE::StaticFunctionTag *, RE::TESObjectREFR *ref) {
+  const auto tasks = SKSE::GetTaskInterface();
+  if (!ref || !tasks)
+    return false;
+  const auto handle = ref->GetHandle();
+  tasks->AddTask([handle] {
+    const auto object = handle.get();
+    if (!object || BuildingManager::IsPlacedObject(object->GetFormID()))
+      return;
+    const auto id = BuildingManager::CreateBuildingFromObject(
+        object.get(), BuildingManager::GridObjectType::kBasic);
+    if (id != BuildingManager::INVALID_BUILDING_ID)
+      BuildingManager::AddPlacedObject(object.get(), id);
+  });
+  return true;
+}
+// It leaves them again (before it is taken down); the navmesh forgets it on the next update.
+void UntrackObject(RE::StaticFunctionTag *, RE::TESObjectREFR *ref) {
+  const auto tasks = SKSE::GetTaskInterface();
+  if (!ref || !tasks)
+    return;
+  const auto id = ref->GetFormID();
+  tasks->AddTask([id] {
+    if (BuildingManager::IsPlacedObject(id))
+      BuildingManager::RemovePlacedObject(id);
+  });
+}
+bool IsTracked(RE::StaticFunctionTag *, RE::TESObjectREFR *ref) {
+  return ref && BuildingManager::IsPlacedObject(ref->GetFormID());
+}
+// lets callers tell this build from one without these functions (an unbound native returns 0)
+// 1: navmesh requests; 2: TrackObject / UntrackObject / IsTracked
+std::int32_t NavmeshApiVersion(RE::StaticFunctionTag *) { return 2; }
+} // namespace
+
+bool RegisterPapyrus(RE::BSScript::IVirtualMachine *vm) {
+  if (!vm)
+    return false;
+  vm->RegisterFunction("RequestNavmesh", "SkyBuildNative", RequestNavmesh);
+  vm->RegisterFunction("NavmeshStage", "SkyBuildNative", NavmeshStage);
+  vm->RegisterFunction("NavmeshBusy", "SkyBuildNative", NavmeshBusy);
+  vm->RegisterFunction("NavmeshProgress", "SkyBuildNative", NavmeshProgress);
+  vm->RegisterFunction("NavmeshMessage", "SkyBuildNative", NavmeshMessage);
+  vm->RegisterFunction("NavmeshApiVersion", "SkyBuildNative", NavmeshApiVersion);
+  vm->RegisterFunction("TrackObject", "SkyBuildNative", TrackObject);
+  vm->RegisterFunction("UntrackObject", "SkyBuildNative", UntrackObject);
+  vm->RegisterFunction("IsTracked", "SkyBuildNative", IsTracked);
+  return true;
+}
+} // namespace SkyBuild::Navmesh
